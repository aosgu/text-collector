{
  "manifest_version": 3,
  "name": "网页文字采集器",
  "version": "1.4.1",
  "description": "选中文字自动保存到采集页；已保存记录支持颜色标签；右键导出 Arena 对话为 Markdown",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-collect": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "切换采集开关"
    }
  },
  "action": {},
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/storage.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://arena.ai/c/*", "https://lmarena.ai/c/*"],
      "js": ["content/arena-exporter.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
